# ================================
# 環境設定
# ================================
# development | production | test
NODE_ENV=development

# ================================
# API 設定
# ================================
# API 基礎 URL
VITE_API_URL=http://localhost:8000/api

# API 逾時時間（毫秒）
VITE_API_TIMEOUT=30000

# ================================
# 應用設定
# ================================
# 應用名稱
VITE_APP_NAME=My App

# 開發伺服器端口
VITE_PORT=3000

# ================================
# 第三方服務（選用）
# ================================
# Google Analytics ID
# VITE_GA_ID=

# Sentry DSN
# VITE_SENTRY_DSN=

# ================================
# 功能開關
# ================================
# 是否啟用 debug 模式
VITE_DEBUG_MODE=true

# 是否啟用模擬數據
VITE_ENABLE_MOCK=false
